    <string name="layout_t9_heading">HOW THE KEYPAD TYPES</string>
    <string name="t9_predictive">Predictive</string>
    <string name="t9_predictive_detail">One tap per letter. The dictionary works out the word, and delete shows the other words those taps could be.</string>
    <string name="t9_multitap">Multi-tap</string>
    <string name="t9_multitap_detail">Press 2 three times for C. No prediction at all — it types exactly the letter you pressed.</string>
    <string name="setup_autocorrect_settings">Autocorrect settings</string>
    <string name="autocorrect_title">Autocorrect</string>
    <string name="autocorrect_strength_heading">HOW MUCH IT FIXES</string>
    <string name="autocorrect_cautious">Cautious</string>
    <string name="autocorrect_cautious_detail">Only clear typos and missing apostrophes. Everything else is offered, not applied.</string>
    <string name="autocorrect_balanced">Balanced</string>
    <string name="autocorrect_balanced_detail">Also fixes words spelled the way they sound, and missing spaces. Recommended.</string>
    <string name="autocorrect_eager">Eager</string>
    <string name="autocorrect_eager_detail">Fixes more, guesses wrong more often. Fastest to type against.</string>
    <string name="autocorrect_delete_heading">THE DELETE KEY</string>
    <string name="delete_cycle">Show other words</string>
    <string name="delete_cycle_detail">After a fix, press delete to see the next-best word. Keep pressing to get back to exactly what you typed.</string>
    <string name="delete_revert">Undo the fix</string>
    <string name="delete_revert_detail">After a fix, one press puts back what you typed. Swiped words still show alternatives.</string>
