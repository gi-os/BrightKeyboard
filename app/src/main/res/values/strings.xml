    <string name="gif_loading">Looking…</string>
    <string name="gif_none">Nothing for that. Try a shorter word.</string>
    <string name="gif_failed">Couldn\'t reach the GIF service.</string>
    <string name="gif_no_key">GIF search needs a key. Add one in Settings.</string>
