    <string name="setup_gifs">GIFs</string>
    <string name="gifs_title">GIFs</string>
    <string name="gifs_blurb">The GIF button on the tools page searches KLIPY. It is the one thing in this keyboard that uses the network \u2014 everything else, the dictionary and the swipe model included, runs on the phone.</string>
    <string name="gifs_key_hint">Your own KLIPY key</string>
    <string name="gifs_key_blurb">Optional. The key built into the app is shared by everyone running it, so when it is spent the search says so. A key of your own from %1$s has its own allowance.</string>
    <string name="gifs_save">Save</string>
    <string name="gifs_saved">Saved</string>
